# ==============================================================================
# CareerForge Environment Configuration Template (.env.example)
# Note: Copy this file to .env for local development. Never commit real secrets.
# ==============================================================================

# --- Application & Server ---
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed frontend origins. Wildcard (*) is forbidden in production.
CORS_ORIGIN=http://localhost:5173

# --- Database (PostgreSQL Container & Connection) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=careerforge
POSTGRES_PORT=5432
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/careerforge?schema=public

# --- Background Worker & Job Queue (pg-boss + PostgreSQL) ---
PG_BOSS_SCHEMA=pgboss

# --- Authentication & Security ---
# Generate a secure 256-bit secret for production (e.g. openssl rand -base64 32)
JWT_SECRET=your-secure-jwt-secret-min-32-characters
JWT_EXPIRES_IN=7d

# HttpOnly Session Cookie Configuration (SEC-01)
# Cookie name (defaults to 'cf_auth')
AUTH_COOKIE_NAME=cf_auth
# Cookie max-age in seconds (defaults to 604800 = 7 days, matching JWT_EXPIRES_IN)
AUTH_COOKIE_MAX_AGE_SEC=604800
# SameSite cookie policy: 'lax' | 'strict' | 'none' (defaults to 'lax')
# Production guidance:
#   - Same-site / custom-domain deployment (e.g. *.careerforge.dev or reverse proxy): SameSite=lax
#   - Cross-site deployment (e.g. Vercel frontend + Render backend): SameSite=none
#   - Note: SameSite=none strictly requires Secure=true (enforced automatically by API)
AUTH_COOKIE_SAMESITE=lax

# --- Student Application Abuse Controls (BUS-01) ---
# Maximum lifetime applications allowed per student (defaults to 100)
MAX_APPLICATIONS_PER_STUDENT=100

# --- AI Integration (Google Gemini API - Free Tier) ---
GEMINI_API_KEY=your-gemini-api-key-here

# --- File Storage (Resume PDF Uploads) ---
# Supported providers: 's3' or 'local'
STORAGE_PROVIDER=local
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET_NAME=careerforge-resumes

# --- Transactional Email (Resend API - Free Tier) ---
# Supported providers: 'resend' or 'mock' (defaults to 'mock' if unspecified or key is placeholder)
EMAIL_PROVIDER=mock
RESEND_API_KEY=your-resend-api-key-here
EMAIL_FROM="CareerForge <notifications@careerforge.dev>"

# --- Frontend Web Client (Vite) ---
VITE_API_BASE_URL=http://localhost:5000/api/v1
