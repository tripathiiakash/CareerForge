# ==============================================================================
# CareerForge Environment Configuration Template (.env.example)
# Note: Copy this file to .env for local development. Never commit real secrets.
# ==============================================================================

# --- Application & Server ---
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# --- Database (PostgreSQL) ---
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/careerforge?schema=public

# --- Background Worker & Job Queue (pg-boss + PostgreSQL) ---
PG_BOSS_SCHEMA=pgboss

# --- Authentication & Security ---
# Generate a secure 256-bit secret for production (e.g. openssl rand -base64 32)
JWT_SECRET=your-secure-jwt-secret-min-32-characters
JWT_EXPIRES_IN=7d

# --- AI Integration (Google Gemini API - Free Tier) ---
GEMINI_API_KEY=your-gemini-api-key-here

# --- File Storage (Resume PDF Uploads) ---
# Supported providers: 's3' or 'local'
STORAGE_PROVIDER=local
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET_NAME=careerforge-resumes

# --- Frontend Web Client (Vite) ---
VITE_API_BASE_URL=http://localhost:5000/api/v1
