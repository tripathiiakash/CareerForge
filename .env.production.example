# ==============================================================================
# CareerForge Production Environment Configuration Template (.env.production.example)
#
# IMPORTANT:
# - NEVER commit real production secrets, API keys, or database credentials.
# - Copy this template to secure environment vaults (e.g. AWS Secrets Manager,
#   Render/Railway Environment Variables, Vercel Project Settings, or Doppler).
# - Generate cryptographic keys using: openssl rand -base64 32
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Process Runtime
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000
LOG_FORMAT=json

# Comma-separated list of allowed production client origins.
# Wildcard (*) is STRICTLY FORBIDDEN in production to prevent CORS bypass attacks.
# Example: https://careerforge.dev,https://app.careerforge.dev
CORS_ORIGIN=https://app.careerforge.dev

# Reverse proxy hop count (1 behind Cloudflare/Render/Vercel/ALB, or true)
TRUST_PROXY=1

# ------------------------------------------------------------------------------
# 2. Production Database (PostgreSQL + SSL)
# ------------------------------------------------------------------------------
# Managed PostgreSQL (Neon, Supabase, AWS RDS, Render Postgres)
# Enforce SSL in transit (sslmode=require) and connection pool sizing.
# Format: postgresql://<user>:<password>@<host>:5432/<dbname>?sslmode=require&connection_limit=20
DATABASE_URL=postgresql://careerforge_user:PLACEHOLDER_STRONG_DB_PASSWORD@db.example.com:5432/careerforge_production?sslmode=require&connection_limit=20

# ------------------------------------------------------------------------------
# 3. Asynchronous Queue Engine (pg-boss + PostgreSQL)
# ------------------------------------------------------------------------------
# Dedicated PostgreSQL schema for queue storage and job idempotency locks.
# Zero external broker dependencies (Redis/BullMQ are NOT used).
PG_BOSS_SCHEMA=pgboss

# ------------------------------------------------------------------------------
# 4. Authentication, Sessions & Security (SEC-01)
# ------------------------------------------------------------------------------
# Minimum 256-bit cryptographically random secret: openssl rand -base64 32
JWT_SECRET=PLACEHOLDER_GENERATE_WITH_OPENSSL_RAND_BASE64_32
JWT_EXPIRES_IN=7d

# HttpOnly Session Cookie Configuration
AUTH_COOKIE_NAME=cf_auth
AUTH_COOKIE_MAX_AGE_SEC=604800

# SameSite Policy:
# - Use 'lax' if frontend and backend share parent domain (e.g. app.careerforge.dev & api.careerforge.dev)
# - Use 'none' if deployed across distinct top-level domains (requires Secure=true, automatically enforced)
AUTH_COOKIE_SAMESITE=lax

# ------------------------------------------------------------------------------
# 5. Production Rate Limiting & Abuse Controls (SEC-07, BUS-01)
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_PUBLIC_MAX=60
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AI_MAX=10
RATE_LIMIT_GLOBAL_MAX=120

# Anti-spam cap on lifetime job applications per student
MAX_APPLICATIONS_PER_STUDENT=100

# ------------------------------------------------------------------------------
# 6. Cloud Object Storage (Resume PDF Artifacts)
# ------------------------------------------------------------------------------
# Set to 's3' for production AWS S3, Cloudflare R2, or MinIO.
STORAGE_PROVIDER=s3
# For Cloudflare R2:
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
S3_ENDPOINT=https://PLACEHOLDER_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=careerforge-production-resumes
S3_ACCESS_KEY_ID=PLACEHOLDER_R2_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=PLACEHOLDER_R2_SECRET_ACCESS_KEY
# Legacy aliases (AWS_ENDPOINT, AWS_REGION, AWS_S3_BUCKET_NAME, etc.) are also supported.

# ------------------------------------------------------------------------------
# 7. Transactional Email Service (Resend API)
# ------------------------------------------------------------------------------
# Set to 'resend' for live email transmission; 'mock' preserves test ledger mode.
EMAIL_PROVIDER=resend
RESEND_API_KEY=PLACEHOLDER_RESEND_API_KEY
EMAIL_FROM="CareerForge <notifications@careerforge.dev>"

# ------------------------------------------------------------------------------
# 8. AI Resume & Interview Analysis (Google Gemini API)
# ------------------------------------------------------------------------------
# Google Gemini API key with generateContent permissions
GEMINI_API_KEY=PLACEHOLDER_GOOGLE_GEMINI_API_KEY

# ------------------------------------------------------------------------------
# 9. Frontend Client Configuration (Vite Build-Time Variables)
# ------------------------------------------------------------------------------
# Base API URL consumed by the React SPA
VITE_API_URL=https://api.careerforge.dev/api/v1
